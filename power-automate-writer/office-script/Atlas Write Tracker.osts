{"version":"0.2.0","body":"interface AtlasProfile { loginId: string; fullName: string; area: string; }\ninterface AtlasInteraction { sourceKind: string; sourceId: string; interactionType: string; receptionDateTime: string; interactionDateTime: string; resolutionDateTime?: string; clientType: string; endClient: string; status: string; resolutionType: string; category: string; subcategory: string; priority: string; incidentNumber: string; comments: string; selected: boolean; }\ninterface AtlasPayload { schemaVersion: number; exportId: string; date: string; profile: AtlasProfile; interactions: AtlasInteraction[]; }\ninterface AtlasResult { inserted: number; updated: number; skipped: number; }\n\nfunction key(value: string): string { return (value || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }\nfunction excelDate(value?: string): number | string { if (!value) return ''; const timestamp = Date.parse(value); return Number.isNaN(timestamp) ? '' : timestamp / 86400000 + 25569; }\n\nfunction main(workbook: ExcelScript.Workbook, payloadJson: string): AtlasResult {\n  const payload = JSON.parse(payloadJson) as AtlasPayload;\n  if (payload.schemaVersion !== 1 || !payload.profile || !Array.isArray(payload.interactions)) throw new Error('Atlas payload is invalid.');\n  const wanted = [payload.profile.fullName, payload.profile.loginId].map(key);\n  const sheet = workbook.getWorksheets().find(item => wanted.includes(key(item.getName())));\n  if (!sheet) throw new Error(`No worksheet matches ${payload.profile.fullName} or ${payload.profile.loginId}.`);\n  const used = sheet.getUsedRange(true);\n  if (!used) throw new Error('The tracker worksheet is empty.');\n  const values = used.getTexts();\n  let headerRow = -1;\n  const headers: {[name: string]: number} = {};\n  for (let row = 0; row < Math.min(values.length, 40); row++) {\n    const candidate: {[name: string]: number} = {};\n    values[row].forEach((value, column) => { const normalized = key(value); if (normalized) candidate[normalized.startsWith('receptiondatetime') ? 'receptiondatetime' : normalized.startsWith('interactiondatetime') ? 'interactiondatetime' : normalized.startsWith('resolutiondatetime') ? 'resolutiondatetime' : normalized.startsWith('incidentnumber') ? 'incidentnumber' : normalized.startsWith('loginidcorpid') ? 'loginidcorpid' : normalized] = column; });\n    if (candidate.interaction !== undefined && candidate.loginidcorpid !== undefined && candidate.interactiondatetime !== undefined) { headerRow = row; Object.assign(headers, candidate); break; }\n  }\n  if (headerRow < 0) throw new Error('Circana tracker headers were not found in the first 40 rows.');\n  const required = ['interaction','loginidcorpid','receptiondatetime','interactiondatetime','resolutiondatetime','area','typeofclient','endclient','status','resolutiontype','category','subcategory','priority','incidentnumber','comments'];\n  const missing = required.filter(name => headers[name] === undefined);\n  if (missing.length) throw new Error(`Tracker columns are missing: ${missing.join(', ')}`);\n  if (headers.sourceid === undefined) { headers.sourceid = Math.max(...Object.values(headers)) + 1; sheet.getCell(headerRow, headers.sourceid).setValue('_source_id'); sheet.getRangeByIndexes(0, headers.sourceid, Math.max(values.length, headerRow + 2), 1).setColumnHidden(true); }\n  const existing: {[sourceId: string]: number} = {};\n  const sourceTexts = sheet.getRangeByIndexes(headerRow + 1, headers.sourceid, Math.max(used.getRowCount() - headerRow - 1, 1), 1).getTexts();\n  sourceTexts.forEach((row, index) => { if (row[0]) existing[row[0]] = headerRow + 1 + index; });\n  let nextRow = Math.max(used.getRowIndex() + used.getRowCount(), headerRow + 1);\n  let inserted = 0, updated = 0, skipped = 0;\n  const set = (row: number, name: string, value: string | number) => sheet.getCell(row, headers[name]).setValue(value);\n  for (const item of payload.interactions) {\n    if (!item.selected || !item.sourceId) { skipped++; continue; }\n    let row = existing[item.sourceId];\n    if (row !== undefined && item.sourceKind === 'manual') { skipped++; continue; }\n    if (row === undefined) { row = nextRow++; existing[item.sourceId] = row; inserted++; } else { updated++; }\n    set(row, 'interaction', item.interactionType); set(row, 'loginidcorpid', payload.profile.loginId);\n    set(row, 'receptiondatetime', excelDate(item.receptionDateTime)); set(row, 'interactiondatetime', excelDate(item.interactionDateTime)); set(row, 'resolutiondatetime', excelDate(item.resolutionDateTime));\n    ['receptiondatetime','interactiondatetime','resolutiondatetime'].forEach(name => sheet.getCell(row, headers[name]).setNumberFormat('mm/dd/yyyy hh:mm'));\n    set(row, 'area', payload.profile.area); set(row, 'typeofclient', item.clientType); set(row, 'endclient', item.endClient); set(row, 'status', item.status); set(row, 'resolutiontype', item.resolutionType); set(row, 'category', item.category); set(row, 'subcategory', item.subcategory); set(row, 'priority', item.priority); set(row, 'incidentnumber', item.incidentNumber); set(row, 'comments', item.comments); set(row, 'sourceid', item.sourceId);\n  }\n  return { inserted, updated, skipped };\n}\n","description":"Writes Atlas daily work rows into the matching Circana tracker worksheet without replacing existing manual tasks.","parameterInfo":"{\"originalParameterOrder\":[\"payloadJson\"],\"parameterSchema\":{\"type\":\"object\",\"properties\":{\"payloadJson\":{\"type\":\"string\"}},\"required\":[\"payloadJson\"]},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"object\",\"properties\":{\"inserted\":{\"type\":\"number\"},\"updated\":{\"type\":\"number\"},\"skipped\":{\"type\":\"number\"}}}}}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}
