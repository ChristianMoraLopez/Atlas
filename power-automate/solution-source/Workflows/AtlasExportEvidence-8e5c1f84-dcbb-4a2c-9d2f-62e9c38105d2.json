{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "atlas_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "atlas_teams"
        },
        "api": {
          "name": "shared_teams"
        }
      },
      "shared_onedriveforbusiness": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "atlas_onedriveforbusiness"
        },
        "api": {
          "name": "shared_onedriveforbusiness"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Every_15_minutes": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 15
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "TargetDate": {
          "type": "Compose",
          "inputs": "@formatDateTime(convertTimeZone(utcNow(),'UTC','SA Pacific Standard Time'),'yyyy-MM-dd')",
          "runAfter": {
            "AtlasInstallationId": [
              "Succeeded"
            ]
          }
        },
        "StartUtc": {
          "type": "Compose",
          "inputs": "@convertToUtc(concat(outputs('TargetDate'),'T00:00:00'),'SA Pacific Standard Time','yyyy-MM-ddTHH:mm:ssZ')",
          "runAfter": {
            "TargetDate": [
              "Succeeded"
            ]
          }
        },
        "EndUtc": {
          "type": "Compose",
          "inputs": "@convertToUtc(concat(formatDateTime(addDays(outputs('TargetDate'),1),'yyyy-MM-dd'),'T00:00:00'),'SA Pacific Standard Time','yyyy-MM-ddTHH:mm:ssZ')",
          "runAfter": {
            "StartUtc": [
              "Succeeded"
            ]
          }
        },
        "Initialize_CalendarEvidence": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CalendarEvidence",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "EndUtc": [
              "Succeeded"
            ]
          }
        },
        "Initialize_MailEvidence": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MailEvidence",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "Initialize_CalendarEvidence": [
              "Succeeded"
            ]
          }
        },
        "Initialize_TeamsEvidence": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "TeamsEvidence",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "Initialize_MailEvidence": [
              "Succeeded"
            ]
          }
        },
        "Calendar_evidence": {
          "type": "Scope",
          "actions": {
            "Get_calendars_V2": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "CalendarGetTables_V2"
                },
                "parameters": {},
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Get_calendar_view_of_events_V3": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "GetEventsCalendarViewV3"
                },
                "parameters": {
                  "calendarId": "@first(body('Get_calendars_V2')?['value'])?['id']",
                  "startDateTimeUtc": "@outputs('StartUtc')",
                  "endDateTimeUtc": "@outputs('EndUtc')",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Get_calendars_V2": [
                  "Succeeded"
                ]
              }
            },
            "Select_calendar_fields": {
              "type": "Select",
              "inputs": {
                "from": "@body('Get_calendar_view_of_events_V3')?['value']",
                "select": {
                  "id": "@item()?['id']",
                  "subject": "@coalesce(item()?['subject'],'')",
                  "start": "@item()?['startWithTimeZone']",
                  "end": "@item()?['endWithTimeZone']",
                  "organizerAddress": "@coalesce(item()?['organizer'],'')",
                  "isCancelled": false
                }
              },
              "runAfter": {
                "Get_calendar_view_of_events_V3": [
                  "Succeeded"
                ]
              }
            },
            "Set_CalendarEvidence": {
              "type": "SetVariable",
              "inputs": {
                "name": "CalendarEvidence",
                "value": "@body('Select_calendar_fields')"
              },
              "runAfter": {
                "Select_calendar_fields": [
                  "Succeeded"
                ]
              }
            },
            "Set_CalendarSourceReady": {
              "type": "SetVariable",
              "inputs": {
                "name": "CalendarSourceReady",
                "value": true
              },
              "runAfter": {
                "Set_CalendarEvidence": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_TeamsSourceReady": [
              "Succeeded"
            ]
          }
        },
        "Mail_evidence": {
          "type": "Scope",
          "actions": {
            "Get_emails_V3": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "GetEmailsV3"
                },
                "parameters": {
                  "folderPath": "Inbox",
                  "fetchOnlyUnread": false,
                  "includeAttachments": false,
                  "top": 100
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Filter_email_to_target_day": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_emails_V3')?['value']",
                "where": "@and(not(empty(item()?['receivedDateTime'])),greaterOrEquals(ticks(item()?['receivedDateTime']),ticks(outputs('StartUtc'))),less(ticks(item()?['receivedDateTime']),ticks(outputs('EndUtc'))))"
              },
              "runAfter": {
                "Get_emails_V3": [
                  "Succeeded"
                ]
              }
            },
            "Select_mail_fields": {
              "type": "Select",
              "inputs": {
                "from": "@body('Filter_email_to_target_day')",
                "select": {
                  "id": "@item()?['id']",
                  "subject": "@coalesce(item()?['subject'],'')",
                  "receivedDateTime": "@item()?['receivedDateTime']",
                  "senderAddress": "@coalesce(item()?['from'],'')",
                  "isDraft": false,
                  "bodyPreview": "@coalesce(item()?['bodyPreview'],'')",
                  "direction": "received"
                }
              },
              "runAfter": {
                "Filter_email_to_target_day": [
                  "Succeeded"
                ]
              }
            },
            "Set_MailEvidence": {
              "type": "SetVariable",
              "inputs": {
                "name": "MailEvidence",
                "value": "@union(body('Select_mail_fields'),body('Select_sent_mail_fields'))"
              },
              "runAfter": {
                "Select_mail_fields": [
                  "Succeeded"
                ],
                "Select_sent_mail_fields": [
                  "Succeeded"
                ]
              }
            },
            "Get_sent_emails_V3": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "GetEmailsV3"
                },
                "parameters": {
                  "folderPath": "Sent Items",
                  "fetchOnlyUnread": false,
                  "includeAttachments": false,
                  "top": 100
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Filter_sent_email_to_target_day": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_sent_emails_V3')?['value']",
                "where": "@and(not(empty(coalesce(item()?['sentDateTime'],item()?['receivedDateTime']))),greaterOrEquals(ticks(coalesce(item()?['sentDateTime'],item()?['receivedDateTime'])),ticks(outputs('StartUtc'))),less(ticks(coalesce(item()?['sentDateTime'],item()?['receivedDateTime'])),ticks(outputs('EndUtc'))))"
              },
              "runAfter": {
                "Get_sent_emails_V3": [
                  "Succeeded"
                ]
              }
            },
            "Select_sent_mail_fields": {
              "type": "Select",
              "inputs": {
                "from": "@body('Filter_sent_email_to_target_day')",
                "select": {
                  "id": "@item()?['id']",
                  "subject": "@coalesce(item()?['subject'],'')",
                  "receivedDateTime": "@coalesce(item()?['sentDateTime'],item()?['receivedDateTime'])",
                  "senderAddress": "@string(item()?['toRecipients'])",
                  "bodyPreview": "@coalesce(item()?['bodyPreview'],'')",
                  "direction": "sent",
                  "isDraft": false
                }
              },
              "runAfter": {
                "Filter_sent_email_to_target_day": [
                  "Succeeded"
                ]
              }
            },
            "Set_MailSourceReady": {
              "type": "SetVariable",
              "inputs": {
                "name": "MailSourceReady",
                "value": true
              },
              "runAfter": {
                "Set_MailEvidence": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_TeamsSourceReady": [
              "Succeeded"
            ]
          }
        },
        "Teams_evidence": {
          "type": "Scope",
          "actions": {
            "List_chats": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "connectionName": "shared_teams",
                  "operationId": "GetChats"
                },
                "parameters": {
                  "chatType": "all",
                  "topic": "all"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "For_each_chat": {
              "type": "Foreach",
              "foreach": "@take(body('Filter_recent_chats'),12)",
              "actions": {
                "Get_messages_in_chat": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                      "connectionName": "shared_teams",
                      "operationId": "GetMessagesFromChat"
                    },
                    "parameters": {
                      "chatId": "@items('For_each_chat')?['id']",
                      "$filter": "@concat('lastModifiedDateTime gt ',outputs('StartUtc'),' and lastModifiedDateTime lt ',outputs('EndUtc'))",
                      "$orderby": "lastModifiedDateTime desc",
                      "$top": 20
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT1M"
                    }
                  },
                  "runAfter": {
                    "Pace_Teams_requests": [
                      "Succeeded"
                    ]
                  }
                },
                "Filter_messages_to_target_day": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Get_messages_in_chat')?['value']",
                    "where": "@and(not(empty(item()?['createdDateTime'])),greaterOrEquals(ticks(item()?['createdDateTime']),ticks(outputs('StartUtc'))),less(ticks(item()?['createdDateTime']),ticks(outputs('EndUtc'))))"
                  },
                  "runAfter": {
                    "Get_messages_in_chat": [
                      "Succeeded"
                    ]
                  }
                },
                "For_each_message": {
                  "type": "Foreach",
                  "foreach": "@body('Filter_messages_to_target_day')",
                  "actions": {
                    "Append_TeamsEvidence": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "TeamsEvidence",
                        "value": {
                          "id": "@items('For_each_message')?['id']",
                          "chatId": "@items('For_each_chat')?['id']",
                          "topic": "@coalesce(items('For_each_chat')?['topic'],'')",
                          "createdDateTime": "@items('For_each_message')?['createdDateTime']",
                          "author": "@coalesce(items('For_each_message')?['from']?['user']?['displayName'],'')",
                          "content": "@coalesce(items('For_each_message')?['body']?['content'],'')",
                          "messageType": "@coalesce(items('For_each_message')?['messageType'],'message')"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {
                    "Filter_messages_to_target_day": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  }
                },
                "Pace_Teams_requests": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 5,
                      "unit": "Second"
                    }
                  },
                  "runAfter": {}
                }
              },
              "runAfter": {
                "Filter_recent_chats": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            },
            "Filter_recent_chats": {
              "type": "Query",
              "inputs": {
                "from": "@body('List_chats')?['value']",
                "where": "@and(not(empty(item()?['lastUpdatedDateTime'])),greaterOrEquals(ticks(item()?['lastUpdatedDateTime']),ticks(outputs('StartUtc'))))"
              },
              "runAfter": {
                "List_chats": [
                  "Succeeded"
                ]
              }
            },
            "Set_TeamsSourceReady": {
              "type": "SetVariable",
              "inputs": {
                "name": "TeamsSourceReady",
                "value": true
              },
              "runAfter": {
                "For_each_chat": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_TeamsSourceReady": [
              "Succeeded"
            ]
          }
        },
        "Compose_Atlas_bundle": {
          "type": "Compose",
          "inputs": {
            "schemaVersion": 3,
            "exportedAt": "@utcNow()",
            "targetDate": "@outputs('TargetDate')",
            "sources": {
              "calendar": "@variables('CalendarSourceReady')",
              "mail": "@variables('MailSourceReady')",
              "teams": "@variables('TeamsSourceReady')"
            },
            "calendar": "@variables('CalendarEvidence')",
            "mail": "@variables('MailEvidence')",
            "teams": "@variables('TeamsEvidence')"
          },
          "runAfter": {
            "Calendar_evidence": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Mail_evidence": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Teams_evidence": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Create_Atlas_evidence_file": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "CreateFile"
            },
            "parameters": {
              "folderPath": "/AtlasBridge/inbox",
              "name": "@concat('atlas-evidence-',outputs('AtlasInstallationId'),'-',outputs('TargetDate'),'-',formatDateTime(utcNow(),'yyyyMMddTHHmmssZ'),'.json')",
              "body": "@string(outputs('Compose_Atlas_bundle'))"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Compose_Atlas_bundle": [
              "Succeeded"
            ]
          }
        },
        "AtlasInstallationId": {
          "type": "Compose",
          "inputs": "unconfigured",
          "runAfter": {}
        },
        "Initialize_CalendarSourceReady": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CalendarSourceReady",
                "type": "boolean",
                "value": false
              }
            ]
          },
          "runAfter": {
            "Initialize_TeamsEvidence": [
              "Succeeded"
            ]
          }
        },
        "Initialize_MailSourceReady": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MailSourceReady",
                "type": "boolean",
                "value": false
              }
            ]
          },
          "runAfter": {
            "Initialize_CalendarSourceReady": [
              "Succeeded"
            ]
          }
        },
        "Initialize_TeamsSourceReady": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "TeamsSourceReady",
                "type": "boolean",
                "value": false
              }
            ]
          },
          "runAfter": {
            "Initialize_MailSourceReady": [
              "Succeeded"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
